{
  "description": "Install GMGN V2 named Agents once per enabled plugin version.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/gmgn/scripts/install_codex_agents.py\" sync --hook",
            "timeout": 10,
            "statusMessage": "Checking GMGN V2 Agent profile version"
          }
        ]
      }
    ]
  }
}
